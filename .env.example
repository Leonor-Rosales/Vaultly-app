# Nombre del proyecto en Docker Compose
COMPOSE_PROJECT_NAME=vaultly

# PostgreSQL
POSTGRES_DB=vaultly_db
POSTGRES_USER=vaultly_admin
POSTGRES_PASSWORD= Usar contra postgres
POSTGRES_PORT=5433

# MinIO
MINIO_ROOT_USER=vaultly_minio_admin
MINIO_ROOT_PASSWORD=usar password minIO
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# Bucket que utilizará el backend
MINIO_BUCKET=vaultly-files